@page "/reporte-excel"
@rendermode InteractiveServer

@using TesoreriaMargaritas.Models
@using TesoreriaMargaritas.Services
@inject IErpService ErpService
@inject ExcelExportService ExcelService
@inject IJSRuntime JS

<PageTitle>Generar Reporte Excel</PageTitle>

<style>
    .corporate-header {
        background: linear-gradient(135deg, #9F1C0A 0%, #7c1608 100%);
        color: white;
        border-radius: 10px 10px 0 0;
    }

    .btn-descargar {
        background-color: #2E7D32;
        color: white;
        border: none;
        padding: 0.8rem 2rem;
        border-radius: 50px;
        font-weight: 600;
        box-shadow: 0 4px 15px rgba(46, 125, 50, 0.3);
        transition: transform 0.2s;
    }

        .btn-descargar:hover:not(:disabled) {
            transform: translateY(-2px);
            background-color: #256a29;
        }

    .card-modern {
        border: none;
        border-radius: 10px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    }

    /* Estilos para el Multi-Select Personalizado */
    .custom-select-button {
        background-color: #fff;
        border: 1px solid #ced4da;
        border-radius: 0.25rem;
        padding: 0.375rem 0.75rem;
        width: 100%;
        text-align: left;
        cursor: pointer;
        position: relative;
        min-height: 38px;
    }

        .custom-select-button:after {
            content: "";
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            border: 5px solid transparent;
            border-top-color: #333;
        }

    .dropdown-panel {
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        max-height: 300px;
        overflow-y: auto;
        background: white;
        border: 1px solid rgba(0,0,0,.15);
        border-radius: 0.25rem;
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,.15);
        z-index: 1000;
        padding: 0.5rem;
        margin-top: 5px;
    }

    .overlay-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 999;
        background: transparent;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            <div class="card card-modern">
                <div class="card-header corporate-header p-4 d-flex align-items-center">
                    <div class="me-3 fs-3">📊</div>
                    <div>
                        <h4 class="mb-0 fw-bold">Informe de Arqueos</h4>
                        <small class="text-white-50">Exportación detallada a Excel</small>
                    </div>
                </div>

                <div class="card-body p-5">
                    @if (mensajeError != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong>Error:</strong> @mensajeError
                            <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
                        </div>
                    }

                    @if (mensajeExito != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @mensajeExito
                            <button type="button" class="btn-close" @onclick="() => mensajeExito = null"></button>
                        </div>
                    }

                    @if (cargandoDatos)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-danger" role="status"></div>
                            <p class="mt-3 text-muted">Conectando con base de datos...</p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-4">
                            <div class="col-12">
                                <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.75rem;">Filtros de Búsqueda</h6>
                            </div>

                            <!-- Rango de Fechas -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Desde</label>
                                <input type="date" class="form-control" @bind="fechaInicio">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Hasta</label>
                                <input type="date" class="form-control" @bind="fechaFin">
                            </div>

                            <!-- Selector de Cajas (Múltiple) -->
                            <div class="col-12 position-relative">
                                <label class="form-label fw-bold">Puntos de Venta / Cajas</label>

                                <button type="button" class="custom-select-button d-flex align-items-center justify-content-between" @onclick="() => mostrarDropdown = !mostrarDropdown">
                                    <span class="text-truncate">
                                        @if (cajasSeleccionadas.Count == 0)
                                        {
                                            <span class="text-muted">-- Seleccione Cajas --</span>
                                        }
                                        else if (TotalCajas > 0 && cajasSeleccionadas.Count == TotalCajas)
                                        {
                                            <span class="fw-bold text-success">Todas las Cajas Seleccionadas</span>
                                        }
                                        else
                                        {
                                            <span>@cajasSeleccionadas.Count cajas seleccionadas</span>
                                        }
                                    </span>
                                </button>

                                @if (mostrarDropdown)
                                {
                                    <!-- Backdrop invisible para cerrar al hacer clic fuera -->
                                    <div class="overlay-backdrop" @onclick="() => mostrarDropdown = false"></div>

                                    <div class="dropdown-panel">
                                        <div class="d-flex justify-content-between mb-2 px-2">
                                            <button class="btn btn-sm btn-outline-primary" @onclick="SeleccionarTodas">Todas</button>
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="LimpiarSeleccion">Ninguna</button>
                                        </div>
                                        <hr class="my-1">

                                        @if (cajasDisponibles != null)
                                        {
                                            @foreach (var punto in cajasDisponibles)
                                            {
                                                <div class="mt-2 mb-1 px-2 fw-bold text-muted small text-uppercase bg-light rounded py-1">
                                                    @punto.Titulo
                                                </div>
                                                @foreach (var caja in punto.Cajas)
                                                {
                                                    // Clave única compuesta
                                                    string key = $"{punto.IdFront}-{caja.CajaFront}";
                                                    bool isSelected = cajasSeleccionadas.Contains(key);

                                                    <div class="form-check ms-2 py-1">
                                                        <input class="form-check-input" type="checkbox"
                                                               checked="@isSelected"
                                                               id="chk_@key"
                                                               @onchange="(e) => ToggleSeleccion(key, e.Value)">
                                                        <label class="form-check-label w-100" for="chk_@key" style="cursor: pointer;">
                                                            @caja.Descripcion <span class="text-muted small ms-1">(ID: @caja.CajaFront)</span>
                                                        </label>
                                                    </div>
                                                }
                                            }
                                        }
                                    </div>
                                }
                                <div class="form-text mt-2"><small>Puede seleccionar una o varias cajas para el reporte unificado.</small></div>
                            </div>

                            <!-- Botones -->
                            <div class="col-12 mt-5 pt-3 border-top d-flex justify-content-between align-items-center">
                                <a href="/" class="btn btn-outline-secondary rounded-pill px-4">Volver</a>

                                <button type="button" class="btn btn-descargar" @onclick="DescargarReporte" disabled="@procesando">
                                    @if (procesando)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>Procesando...</span>
                                    }
                                    else
                                    {
                                        <span>📥 Descargar Excel</span>
                                    }
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private DateTime fechaInicio = DateTime.Now.AddDays(-7);
    private DateTime fechaFin = DateTime.Now;

    // Almacena claves "IdFront-IdCaja"
    private HashSet<string> cajasSeleccionadas = new HashSet<string>();
    private bool mostrarDropdown = false;

    private List<RemFront> cajasDisponibles = new List<RemFront>();
    private bool procesando = false;
    private bool cargandoDatos = true;
    private string? mensajeError;
    private string? mensajeExito;

    // Propiedad auxiliar para saber el total de cajas disponibles
    private int TotalCajas => cajasDisponibles?.Sum(p => p.Cajas.Count) ?? 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarDatosIniciales();
            StateHasChanged();
        }
    }

    private async Task CargarDatosIniciales()
    {
        try
        {
            cargandoDatos = true;
            StateHasChanged();

            cajasDisponibles = await ErpService.ObtenerPuntosActivosConCajasAsync();
            // Por defecto seleccionamos todas
            SeleccionarTodas();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error cargando cajas: {ex.Message}";
        }
        finally
        {
            cargandoDatos = false;
            StateHasChanged();
        }
    }

    private void ToggleSeleccion(string key, object? checkedValue)
    {
        bool isChecked = (bool)(checkedValue ?? false);
        if (isChecked) cajasSeleccionadas.Add(key);
        else cajasSeleccionadas.Remove(key);
    }

    private void SeleccionarTodas()
    {
        cajasSeleccionadas.Clear();
        if (cajasDisponibles != null)
        {
            foreach (var punto in cajasDisponibles)
            {
                foreach (var caja in punto.Cajas)
                {
                    cajasSeleccionadas.Add($"{punto.IdFront}-{caja.CajaFront}");
                }
            }
        }
    }

    private void LimpiarSeleccion()
    {
        cajasSeleccionadas.Clear();
    }

    private async Task DescargarReporte()
    {
        if (cajasSeleccionadas.Count == 0)
        {
            mensajeError = "Debe seleccionar al menos una caja para generar el reporte.";
            return;
        }

        procesando = true;
        mensajeError = null;
        mensajeExito = null;
        await Task.Yield();

        try
        {
            var todasLasFilas = new List<ArqueoGridDto>();
            var todosLosEncabezados = new HashSet<string>();

            // Iteramos sobre cada caja seleccionada
            foreach (var key in cajasSeleccionadas)
            {
                var partes = key.Split('-');
                if (partes.Length == 2 && int.TryParse(partes[0], out int idFront) && int.TryParse(partes[1], out int idCaja))
                {
                    // Consultamos el reporte individual por caja
                    var reporteCaja = await ErpService.ObtenerReporteArqueosPorRango(idFront, idCaja, fechaInicio, fechaFin);

                    if (reporteCaja.Filas.Any())
                    {
                        todasLasFilas.AddRange(reporteCaja.Filas);

                        // Recolectamos los encabezados de pago dinámicos (Visa, Mastercard, etc.)
                        foreach (var header in reporteCaja.EncabezadosPagos)
                        {
                            todosLosEncabezados.Add(header);
                        }
                    }
                }
            }

            if (!todasLasFilas.Any())
            {
                mensajeError = $"No se encontraron registros entre {fechaInicio:dd/MM} y {fechaFin:dd/MM} para las cajas seleccionadas.";
            }
            else
            {
                // Ordenamos por fecha descendente globalmente
                var filasOrdenadas = todasLasFilas.OrderByDescending(f => f.Fecha).ThenByDescending(f => f.Hora).ToList();
                var headersOrdenados = todosLosEncabezados.OrderBy(x => x).ToList();

                var excelBytes = ExcelService.GenerarReporteArqueos(filasOrdenadas, headersOrdenados, "Reporte Unificado");

                var fileName = $"Reporte_Consolidado_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
                await JS.InvokeVoidAsync("saveAsFile", fileName, Convert.ToBase64String(excelBytes));

                mensajeExito = "Reporte consolidado descargado correctamente.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error generando reporte: {ex.Message}";
        }
        finally
        {
            procesando = false;
        }
    }
}